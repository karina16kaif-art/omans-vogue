PORT=5001
# Production requires an explicit true to accept new checkout quotes and submissions.
# Set false for the initial production deploy.
CHECKOUT_ENABLED=true
NODE_ENV=development
CLIENT_ORIGIN=https://omansvogue.netlify.app
CORS_ORIGINS=https://omansvogue.netlify.app,http://localhost:5173,http://127.0.0.1:5173
ADMIN_USERNAME=concierge
# Initial sign-in only. Use a unique password of at least 12 characters.
ADMIN_PASSWORD=
# Use a random secret of at least 32 characters in production.
JWT_SECRET=
DATA_DIR=./data
UPLOADS_DIR=./public/uploads/products
BRAND_UPLOADS_DIR=./public/uploads/brand

# Optional Gmail order notification. Use a Gmail app password, not the normal Gmail login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# Optional WhatsApp alert webhook for a future WhatsApp Business/Twilio/automation provider.
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_ALERT_WEBHOOK_URL=

# Supabase is required for customer checkout. Apply the migration in supabase/migrations first.
SUPABASE_URL=
# Use a server secret key or the legacy service-role JWT.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
